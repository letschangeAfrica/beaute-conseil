# Copy this file to .env.local and paste your key.
# Get a key at https://console.anthropic.com/ (Settings → API keys).
# Needed for: selfie shade analysis, live price comparison, and the chat advisor.
# Search, scoring, scanner and store prices work without it.
ANTHROPIC_API_KEY=sk-ant-...

# --- Cost protection ---
# Max estimated Claude spend per day (USD), across all visitors. Default: 5.
DAILY_BUDGET_USD=5
# Redis for rate limits, the spend counter and the price cache (required once deployed).
# On Vercel: Storage → Create → Upstash for Redis → connect to the project; these are added for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Sign in with Google (Auth.js) ---
# Random secret that encrypts the session cookie. Generate one with:
#   npx auth secret      (or: openssl rand -base64 32)
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
